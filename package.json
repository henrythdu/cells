{
  "name": "@henrythdu/cells",
  "version": "0.0.46",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "cells": "dist/cli.js"
  },
  "files": [
    "dist",
    "grammars",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "description": "Code organized into context-bounded cells for LLMs coding alongside humans.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc && tsc -p tsconfig.test.json && node scripts/build-manifest.mjs && biome check .",
    "prepare": "tsc && chmod +x dist/cli.js && node scripts/build-manifest.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "minimatch": "^10.2.5",
    "smol-toml": "^1.3.1",
    "web-tree-sitter": "^0.26.11"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^2.1.9",
    "knip": "^6.32.2",
    "typescript": "^5.9.3",
    "vitest": "^2.1.0"
  }
}
